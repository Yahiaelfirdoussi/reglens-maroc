# RegLens Maroc — environment configuration.
# Copy to .env and fill in. Every variable uses the REGLENS_ prefix.

# --- General ---
REGLENS_ENV=dev                     # dev | test | prod
REGLENS_LOG_LEVEL=INFO
REGLENS_LOG_JSON=false              # true in prod (JSON logs)

# --- Paths ---
REGLENS_DATA_DIR=data/raw

# --- Qdrant ---
REGLENS_QDRANT_URL=http://localhost:6333
REGLENS_QDRANT_API_KEY=
REGLENS_QDRANT_COLLECTION=reglens

# --- Retrieval ---
REGLENS_TOP_K=6

# --- LLM (via LiteLLM; provider is config, not code) ---
REGLENS_LLM_MODEL=
REGLENS_LLM_API_KEY=
